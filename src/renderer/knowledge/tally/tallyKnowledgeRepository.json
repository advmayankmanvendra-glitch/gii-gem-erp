      "concept": {
        "name": "Group (Account Head)",
        "description": "A classification category that organizes ledgers into functional groups for reporting and hierarchy.",
        "businessContext": "Groups define the structure of the Chart of Accounts. Every ledger belongs to exactly one group. Groups determine financial statement placement (Balance Sheet vs P&L), debit/credit nature, and reporting behaviour.",
        "erpModule": "Chart of Accounts",
        "sourceSystem": "TallyPrime"
      },
      "workflow": {
        "creationPath": "Chart of Accounts → Group → Add Group",
        "involvedScreens": ["Chart of Accounts", "Chart of Accounts Group Master"],
        "businessProcesses": ["Chart of Accounts Design", "Financial Year Setup", "Migration Data Load"]
      },
      "accountingImpact": {
        "debitNature": "Depends on group type (Asset/Expense = debit; Liability/Income = credit)",
        "creditNature": "Inverse of debit nature",
        "affectsTrialBalance": true,
        "affectsBalanceSheet": true,
        "affectsProfitAndLoss": true,
        "notes": "Primary groups directly determine financial statement placement. Sub-groups inherit parent behaviour unless overridden."
      },
      "inventoryImpact": {
        "hasImpact": false
      },
      "gstImpact": {
        "hasImpact": false,
        "notes": "Groups do not carry GST data directly. GST is configured at the ledger level."
      },
      "reports": {
        "primaryReports": ["Group Summary", "Group Voucher Summary"],
        "financialReports": ["Trial Balance", "Balance Sheet", "Profit & Loss Account"],
        "reportingImpact": "Group hierarchy determines the drill-down structure in all financial reports"
      },
      "aiExplanation": {
        "simpleDefinition": "A group is a folder that organises ledgers by function for reporting.",
        "businessContext": "Think of it like departments in an office — all Sales ledgers go under 'Sales Accounts', all bank accounts under 'Bank Accounts'.",
        "relatedConcepts": ["Ledger", "Chart of Accounts", "Trial Balance"],
        "commonQuestions": ["Which group does this ledger belong to?", "Show all groups and their ledgers"]
      }
