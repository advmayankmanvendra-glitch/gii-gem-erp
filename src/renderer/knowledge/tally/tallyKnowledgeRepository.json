      "concept": {
        "name": "Ledger (Account)",
        "description": "An individual account within a group that records all financial transactions for a specific entity or head.",
        "businessContext": "Every party (customer, supplier, employee), bank account, expense head, and income head is a ledger. Ledgers are the atomic unit of accounting — all voucher entries reference ledgers.",
        "erpModule": "Ledger Master / Party Master",
        "sourceSystem": "TallyPrime",
        "universalEquivalent": {
          "sap": "Customer/Vendor/GL Account",
          "oracle": "Customer/Supplier/Account",
          "quickbooks": "Customer/Vendor/Chart of Accounts",
          "zoho": "Contact/Account"
        }
      },
      "workflow": {
        "creationPath": "Chart of Accounts → Ledger → Add Ledger (or Create Party)",
        "involvedScreens": [
          "Chart of Accounts (creation)",
          "Ledger Master (review/edit)",
          "Party Ledger (if Sundry Debtors/Creditors)",
          "Voucher Entry (when referenced)"
        ],
        "voucherPostingPath": "Ledger → Voucher Entry → Ledger Entry Receivable/Payable → Outstanding Management",
        "businessProcesses": [
          "Party Onboarding (customer/supplier setup)",
          "Chart of Accounts Maintenance",
          "Opening Balance Loading",
          "GST Registration Setup for E-Way Bill / E-Invoice"
        ],
        "lifecycleEvents": [
          "Creation → Opening Balance Entry → Regular Transaction Posting → Period-End Reconciliation → Closing Transfer"
        ]
      },
