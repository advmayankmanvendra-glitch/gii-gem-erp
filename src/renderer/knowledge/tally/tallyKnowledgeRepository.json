      "concept": {
        "name": "Voucher (Transaction)",
        "description": "A financial transaction record that documents movement of money, goods, or value between accounts.",
        "businessContext": "Vouchers are the primary data entry mechanism. Every business event — a sale, purchase, payment, receipt, journal adjustment — is recorded as a voucher. Vouchers carry ledger entries, inventory entries, tax calculations, and bill allocations.",
        "erpModule": "Voucher Entry (transaction processing)",
        "sourceSystem": "TallyPrime",
        "universalEquivalent": {
          "sap": "FI Document (FB01/FB50)",
          "oracle": "Journal Entry / Transaction",
          "quickbooks": "Transaction (Invoice/Bill/Check)",
          "zoho": "Transaction Record"
        }
      },
      "workflow": {
        "creationPath": "Voucher Type → Voucher Entry → Select Ledgers → Enter Amounts → Save → Post",
        "voucherSubTypes": {
          "Receipt": "Cash/Bank receipt from debtor or customer",
          "Payment": "Cash/Bank payment to creditor or supplier",
          "Sales": "Goods/services sold → debtor debited, sales credited, inventory reduced",
          "Purchase": "Goods/services purchased → purchase debited, creditor credited, inventory increased",
          "Journal": "Non-cash adjustments between ledgers (depreciation, provisions, transfers)",
          "Contra": "Transfer between cash/bank accounts (cash deposit, bank transfer)",
          "Credit Note": "Sales return or reduction in amount receivable",
          "Debit Note": "Purchase return or reduction in amount payable"
        },
        "involvedScreens": [
          "Voucher Entry (new/edit)",
          "Voucher Type Selection",
          "Ledger Selection (auto-suggest)",
          "Inventory Allocation (for Sales/Purchase)",
          "Bill Allocation (for outstanding tracking)",
          "GST Detail Entry (e-invoice generation)"
        ],
        "businessProcesses": [
          "Day-to-Day Transaction Recording",
          "Monthly Closure",
          "GST Return Filing (voucher summaries)",
          "E-Way Bill Generation (inter-state sales)",
          "E-Invoice Generation (B2B sales)"
        ],
        "lifecycleEvents": [
          "Draft → Save → Post → Reverse (if incorrect) → Re-post",
          "Audit: Voucher → Ledger → Trial Balance → Financial Statement"
        ]
      },
      "database": {
        "primaryTable": "vouchers",
        "relatedTables": [
          "voucher_lines (debit/credit entries per ledger)",
          "stock_ledger (inventory movement for stock-impacting vouchers)",
          "gst_details (GST calculation per line item)",
          "bill_allocations (outstanding management)",
          "audit_log (voucher lifecycle tracking)",
          "e_invoice_details (e-invoice reference)"
        ],
        "keyFields": {
          "voucher_type": { "source": "VOUCHERTYPENAME", "type": "varchar(20)", "classification": "A" },
          "voucher_number": { "source": "VOUCHERNUMBER", "type": "varchar(20)", "classification": "A" },
          "voucher_date": { "source": "DATE", "type": "date", "classification": "A" },
          "effective_date": { "source": "EFFECTIVEDATE", "type": "date", "classification": "A" },
          "company_gstin": { "source": "CMPGSTIN", "type": "varchar(15)", "classification": "A" },
          "party_gstin": { "source": "PARTYGSTIN", "type": "varchar(15)", "classification": "A" },
          "party_state": { "source": "PARTYLEDGERSTATE", "type": "varchar(50)", "classification": "A" },
          "narration": { "source": "NARRATION", "type": "text", "classification": "B" },
          "is_cancelled": { "source": "ISCANCELLED", "type": "boolean", "classification": "A" },
          "legacy_id": { "source": "ALTERID", "type": "integer", "classification": "B" }
        }
      },
      "accountingImpact": {
        "debitEntries": "Every voucher has at least one debit entry (which ledger is debited and by how much).",
        "creditEntries": "Every voucher has at least one credit entry (which ledger is credited and by how much). Total debits must equal total credits.",
        "doubleEntryRule": "For every voucher, sum(debits) = sum(credits). Vouchers with inventory also update stock valuation.",
        "affectsTrialBalance": true,
        "affectsBalanceSheet": true,
        "affectsProfitAndLoss": true,
        "affectsCashFlow": true,
        "affectsReceivables": "Receipt/Sales/Credit Note vouchers update receivables",
        "affectsPayables": "Payment/Purchase/Debit Note vouchers update payables",
        "entriesInvolved": ["voucher_lines (one per debit/credit line)", "stock_ledger (if inventory)", "bill_allocations (if outstanding)", "gst_details (if taxable)"],
        "accountingEffectDetails": {
          "Sales": "Debit: Debtor (+Receivable) | Credit: Sales (+Income) | Credit: GST Output (+Liability) | Stock: Reduce inventory",
          "Purchase": "Debit: Purchase (+Expense) | Debit: GST Input (+Asset) | Credit: Creditor (+Payable) | Stock: Increase inventory",
          "Receipt": "Debit: Bank/Cash (+Asset) | Credit: Debtor (-Receivable)",
          "Payment": "Debit: Creditor (-Payable) | Credit: Bank/Cash (-Asset)",
          "Journal": "Debit: Target Ledger | Credit: Source Ledger | No cash/stock impact"
        }
      },
      "inventoryImpact": {
        "hasImpact": true,
        "affectsStockValuation": true,
        "affectsStockQuantity": true,
        "conditions": "Only Sales, Purchase, Stock Journal, Delivery Note, Receipt Note, Material In/Out affect inventory. Receipt and Payment do not.",
        "stockImpactDetails": {
          "Sales": "Reduces stock quantity and value (COGS debited, stock credited)",
          "Purchase": "Increases stock quantity and value (Purchase cost, valuation method applied)",
          "Stock Journal": "Transfers stock between godowns or stock groups (no value change)",
          "Sales Return": "Increases stock back (debit stock, credit COGS)",
          "Purchase Return": "Decreases stock (debit creditor, credit stock)"
        },
        "valuationMethods": ["FIFO", "Average Cost", "Standard Cost"]
      },
      "gstImpact": {
        "hasGstImpact": true,
        "gstFields": ["CMPGSTIN", "PARTYGSTIN", "CMPGSTSTATE", "PARTYLEDGERSTATE", "VCHGSTCLASSIFICATION"],
        "affectsGstReturns": true,
        "gstTaxTypes": ["CGST+SGST (intra-state)", "IGST (inter-state)", "Nil Rated", "Exempted", "SEZ"],
        "gstReturnMapping": {
          "Sales": "GSTR-1 (outward supply)",
          "Purchase": "GSTR-2A/2B (inward supply auto-populated)",
          "Credit Note": "GSTR-1 (negative entry)",
          "Debit Note": "GSTR-2A (amendment)"
        },
        "hsnSacMapping": "HSN codes from stock items (goods) / SAC codes from service ledgers",
        "eInvoiceRelevant": true,
        "eWayBillRelevant": "Inter-state stock transfers and sales > Rs. 50,000"
      },
      "reports": {
        "primaryReports": ["Voucher Register", "Day Book", "Voucher Type Summary"],
        "financialReports": ["Trial Balance (aggregated)", "General Ledger (drill-down)", "Profit & Loss (monthly)", "Balance Sheet (period-end)"],
        "regulatoryReports": ["GSTR-1 (sales voucher summary)", "GSTR-3B (monthly return)", "E-Invoice (IRN generation)", "E-Way Bill (transport document)"],
        "operationalReports": ["Outstanding Receivables (from sales/receipt)", "Outstanding Payables (from purchase/payment)", "Cash Flow Forecast (receipt/payment patterns)", "GST Credit Reconciliation (purchase vs GSTR-2A)"],
        "dashboardWidgets": ["Today's Vouchers", "Pending E-Way Bills", "Unreconciled Payments", "GST Liability Summary"],
        "reportingImpact": "Every voucher posted immediately affects all downstream reports. Reversing a historical voucher restates Trial Balance and GST returns for the affected period."
      },
      "aiExplanation": {
        "simpleDefinition": "A voucher is a financial record that shows money moving from one account to another, like a digital receipt or payment slip.",
        "businessContext": "When you sell goods, a Sales voucher is created — it debits the customer's account (they owe you money) and credits your Sales account (you earned income). If the customer pays later, a Receipt voucher moves money from cash to reduce what they owe.",
        "relatedConcepts": ["Ledger", "Voucher Type", "GST", "Stock Item", "Receivable", "Payable", "Day Book"],
        "commonQuestions": [
          "Show all sales vouchers for this month",
          "Find voucher number INV-2026-042",
          "Why is this voucher not reflecting in GST return?",
          "Can I reverse a posted voucher?"
        ],
        "impactExplanation": "Posting a Sales voucher increases your income and the customer's receivable. It reduces inventory. It generates GST liability. It feeds into GSTR-1. Reversing it requires an equal and opposite entry or a credit note.",
        "helpAssistantIntegration": "Vouchers are searchable by number, date, party, amount, type, and GSTIN. The Help Assistant can show the voucher's accounting effect, GST calculation, and impact on outstanding balances."
      }
    },
