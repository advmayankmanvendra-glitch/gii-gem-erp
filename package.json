{
  "name": "gii-gem-erp",
  "version": "0.1.0-internal-test",
  "description": "GII GeM ERP - offline Windows desktop ERP for government supply, procurement and profitability management.",
  "main": "src/main/main.js",
  "private": true,
  "author": {
    "name": "Gesture India Systems Private Limited",
    "email": "infra@gestureindia.com",
    "url": "https://www.gestureindia.com"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dev-port.js",
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "db:init": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu src/main/database/init.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "lint:syntax": "node --check src/main/main.js && node --check src/main/config/verificationConfig.js && node --check src/main/services/safeDeleteService.js && node --check src/main/database/init.js && node --check src/preload/preload.cjs && node --check scripts/check-dev-port.js && node --check scripts/verify-knowledge.js && node --check scripts/verify-workflow-graph.js && node --check scripts/verify-database-graph.js && node --check scripts/verify-voucher-accounting-graph.js && node --check scripts/verify-financials.js && node --check scripts/verify-controls.js && node --check scripts/verify-audit.js && node --check scripts/verify-erp.js && node --check scripts/verify-erp-brain.js && node --check scripts/verify-help-assistant-brain.js && node --check scripts/verify-assistant-natural-language-relevance.js && node --check scripts/assistant-natural-query-bank.js && node --check scripts/lib/verificationProfiles.js && node --check scripts/verify-production-readiness-sql.js && node --check scripts/verify-fk-constraints.js && node --check scripts/verify-safe-delete.js && node --check scripts/verify-screen-actions.js && node --check scripts/verify-alphabetical-option-order.js && node --check scripts/verify-workflow-enforcement-foundation.js && node --check scripts/verify-entity-picker-integration.js",
    "verify:production-readiness-sql": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-production-readiness-sql.js",
    "verify:fk-constraints": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-fk-constraints.js",
    "verify:safe-delete": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-safe-delete.js",
    "verify:screen-actions": "node scripts/verify-screen-actions.js",
    "verify:alphabetical-options": "node scripts/verify-alphabetical-option-order.js",
    "verify:entity-picker": "node scripts/verify-entity-picker-integration.js",
    "verify:accounting": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-accounting.js",
    "verify:accounting:production": "cross-env VERIFY_PROFILE=production electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-accounting.js",
    "verify:financials": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-financials.js",
    "verify:financials:production": "cross-env VERIFY_PROFILE=production electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-financials.js",
    "verify:controls": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-controls.js",
    "verify:voucher-inventory": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-voucher-workflows-inventory.js",
    "verify:phase10": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-phase10-inventory-automation.js",
    "verify:flow": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/verify-operational-flow.js",
    "verify:knowledge": "node scripts/verify-knowledge.js",
    "verify:workflow-graph": "node scripts/verify-workflow-graph.js",
    "verify:database-graph": "node scripts/verify-database-graph.js",
    "verify:voucher-accounting-graph": "node scripts/verify-voucher-accounting-graph.js",
    "verify:erp-brain": "node scripts/verify-erp-brain.js",
    "verify:help-assistant-brain": "node scripts/verify-help-assistant-brain.js",
    "verify:read-only-assistant": "node scripts/verify-read-only-erp-assistant-plan.js",
    "verify:feature-function-graph": "node scripts/verify-feature-function-graph.js",
    "verify:assistant-relevance": "node scripts/verify-assistant-natural-language-relevance.js",
    "verify:audit": "node scripts/verify-audit.js",
    "verify:workflow-enforcement": "node scripts/verify-workflow-enforcement-foundation.js",
    "verify:erp": "node scripts/verify-erp.js",
    "test-data:pack-v1": "electron --disable-gpu --disable-gpu-compositing --disable-gpu-sandbox --disable-accelerated-2d-canvas --in-process-gpu scripts/create-erp-test-data-pack-v1.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.2.0",
    "playwright": "^1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "ajv": "^8.17.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "in.gestureindiainfrastructure.giigemerp",
    "productName": "GII GeM ERP",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist",
      "src/main",
      "src/preload",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "database/gii_gem_erp.db",
        "to": "database/gii_gem_erp.db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "GII-GeM-ERP-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "GII-GeM-ERP-Portable-${version}-${arch}.${ext}"
    }
  }
}
