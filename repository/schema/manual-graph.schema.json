{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gii-gem-erp:kg-5:schema:1.0.0",
  "title": "KG-5 Document and Manual Graph Schema",
  "description": "JSON Schema for the KG-5 Document and Manual Graph. Follows the Enterprise Intelligence Layer schema contract. Frozen at schemaVersion 1.0.0.",
  "type": "object",
  "schemaVersion": "1.0.0",
  "graphId": "KG-5",
  "required": [
    "schemaVersion", "graphId", "generatedAt", "owner", "description",
    "version", "status",
    "dependencies", "relationships", "manuals",
    "knownGaps", "sourceDocuments", "validationRules",
    "risk", "metadata", "statistics", "compatibility", "futureExtensions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of the KG-5 schema.",
      "enum": ["1.0.0"]
    },
    "graphId": {
      "type": "string",
      "description": "Unique graph identifier.",
      "enum": ["KG-5"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update."
    },
    "owner": {
      "type": "string",
      "description": "Owner of this graph.",
      "enum": ["Architecture & Governance"]
    },
    "description": {
      "type": "string",
      "description": "Description of the document and manual graph."
    },
    "version": {
      "type": "string",
      "description": "Graph data version."
    },
    "status": {
      "type": "string",
      "enum": ["active", "partial", "planned", "deprecated"],
      "description": "Graph lifecycle status."
    },
    "dependencies": {
      "type": "object",
      "description": "Cross-graph dependency declarations.",
      "required": ["dependsOn", "dependedBy"],
      "properties": {
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependedBy": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "relationships": {
      "type": "object",
      "description": "Cross-reference metadata for the graph.",
      "required": ["manualToFeature", "manualToWorkflowStage", "manualToScreen", "manualToReport", "manualToError"],
      "properties": {
        "manualToFeature": { "type": "array", "items": { "type": "string" } },
        "manualToWorkflowStage": { "type": "array", "items": { "type": "string" } },
        "manualToScreen": { "type": "array", "items": { "type": "string" } },
        "manualToReport": { "type": "array", "items": { "type": "string" } },
        "manualToError": { "type": "array", "items": { "type": "string" } }
      }
    },
    "manuals": {
      "type": "array",
      "description": "Documented ERP manuals with section indexes and cross-references.",
      "items": {
        "type": "object",
        "required": [
          "manualId", "title", "fileName", "sourcePath", "lineCount",
          "sectionCount", "category", "status", "sections", "topics"
        ],
        "properties": {
          "manualId": { "type": "string" },
          "title": { "type": "string" },
          "fileName": { "type": "string" },
          "sourcePath": { "type": "string" },
          "lineCount": { "type": "integer", "minimum": 1 },
          "sectionCount": { "type": "integer", "minimum": 1 },
          "category": { "type": "string", "enum": ["user-operations", "administration", "troubleshooting"] },
          "status": { "type": "string", "enum": ["current", "stale", "unknown"] },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sectionId", "heading", "excerpt"],
              "properties": {
                "sectionId": { "type": "string" },
                "heading": { "type": "string" },
                "excerpt": { "type": "string" }
              }
            }
          },
          "topics": { "type": "array", "items": { "type": "string" } },
          "featureRefs": { "type": "array", "items": { "type": "string" } },
          "workflowStageRefs": { "type": "array", "items": { "type": "string" } },
          "screenRefs": { "type": "array", "items": { "type": "string" } },
          "reportRefs": { "type": "array", "items": { "type": "string" } },
          "errorRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "knownGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "mitigation"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "sourceDocuments": {
      "type": "array",
      "description": "Source document paths; every path must resolve at verification time.",
      "items": { "type": "string" }
    },
    "validationRules": {
      "type": "array",
      "description": "Validation rules enforced by the KG-5 verifier.",
      "items": { "type": "string" }
    },
    "risk": {
      "type": "object",
      "description": "Risk assessment for the graph."
    },
    "metadata": {
      "type": "object",
      "description": "Repository metadata."
    },
    "statistics": {
      "type": "object",
      "description": "Aggregate counts and metrics.",
      "required": ["manualCount", "sectionCount", "topicCount", "referenceCount"],
      "properties": {
        "manualCount": { "type": "integer" },
        "sectionCount": { "type": "integer" },
        "topicCount": { "type": "integer" },
        "referenceCount": { "type": "integer" }
      }
    },
    "compatibility": {
      "type": "object",
      "description": "Compatibility declarations with other graphs.",
      "required": ["kg5CompatibleWith", "graphRegistry"],
      "properties": {
        "kg5CompatibleWith": { "type": "array", "items": { "type": "string" } },
        "graphRegistry": {
          "type": "object",
          "required": ["requiresRegistryVersion", "requiresEILVersion"],
          "properties": {
            "requiresRegistryVersion": { "type": "string" },
            "requiresEILVersion": { "type": "string" }
          }
        }
      }
    },
    "futureExtensions": {
      "type": "object",
      "description": "Planned extensions for the graph."
    }
  }
}
